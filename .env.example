# Copy this file to `.env` on the server (same directory as docker-compose.yml) and fill in real values.
# `.env` is read automatically by `docker compose` for variable substitution above — do not commit it.

POSTGRES_USER=expense_user
POSTGRES_PASSWORD=changeme-pick-a-real-password
POSTGRES_DB=expenses

# MongoDB runs alongside Postgres during the dual-write migration window (see
# backend/services/mongo_sync.py). Postgres remains the source of truth.
MONGO_USER=expense_user
MONGO_PASSWORD=changeme-pick-a-real-password
MONGO_DB=expense_manager

# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Example generated value (do not reuse this one — generate a fresh one per deployment):
# aeafdf0acdafda3374fa7c979181d2ec3eb86c029b2490e663fd4e27985560d7
SECRET_KEY=changeme-generate-a-real-one

FRONTEND_PORT=8080

# Assumes Ollama runs directly on the Ubuntu server host (installed separately, not in Docker).
# If Ollama lives elsewhere, change this to that machine's reachable address instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=30
